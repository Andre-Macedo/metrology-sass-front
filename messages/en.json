          "title": "Methodology & Formulas (JCGM 100:2008)",
          "u_title": "1. Standard Uncertainty (u)",
          "u_formula": "u = Value / Divisor",
          "u_desc": "Divisor depends on distribution:\n• Normal (k=1): 1\n• Rectangular: √3 ≈ 1.732\n• Triangular: √6 ≈ 2.449",
          "uc_title": "2. Combined Uncertainty (uc)",
          "uc_formula": "uc = √(u₁² + u₂² + ... + uₙ²)",
          "uc_desc": "Root sum of squares of all standard uncertainties.",
          "U_title": "3. Expanded Uncertainty (U)",
          "U_formula": "U = uc × k",
          "U_desc": "Where k is the coverage factor (typically 2 for 95.45% confidence)."
        }
      }
